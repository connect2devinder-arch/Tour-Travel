rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/config/admins)
        && request.auth.token.email in get(/databases/$(database)/documents/config/admins).data.emails;
    }

    match /config/admins {
      allow read: if isAdmin();
      allow write: if false; // seeded via tooling; edit the list in the Firebase console
    }

    // Journal posts. Published posts are public; drafts, pending and rejected
    // posts are visible to their author and to admins.
    match /posts/{postId} {
      // Authors may write for themselves, but only as a draft or submitted for
      // review. Publishing is an admin action.
      allow create: if isAdmin()
        || (request.auth != null
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.status in ['draft', 'pending']);

      // Authors may edit their own posts. Editing a live post sends it back
      // for review, and they cannot change ownership or admin-only fields.
      allow update: if isAdmin()
        || (request.auth != null
            && resource.data.authorUid == request.auth.uid
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.status in ['draft', 'pending', 'rejected']
            && (resource.data.status != 'published' || request.resource.data.status == 'pending')
            && request.resource.data.featured == resource.data.featured
            && (request.resource.data.publishedAt == resource.data.publishedAt
                || request.resource.data.publishedAt == null));

      allow delete: if isAdmin()
        || (request.auth != null && resource.data.authorUid == request.auth.uid);

      allow read: if resource.data.status == 'published'
        || isAdmin()
        || (request.auth != null && resource.data.authorUid == request.auth.uid);
    }

    // Tour packages managed from the admin panel. Published packages are public;
    // public list queries must filter on status == 'published'.
    match /packages/{packageId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Bookings are created and payment-confirmed by trusted Cloud Functions.
    // Clients can only read their own booking; admins can manage all bookings.
    match /bookings/{bookingId} {
      allow create: if false;
      allow read: if (request.auth != null && request.auth.token.email == resource.data.email) || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Email and SMS notifications generated for booking and enquiry events.
    // Delivery is simulated in this POC, so only admins read or update them.
    match /notifications/{notificationId} {
      allow create: if validNotification();
      allow read, update, delete: if isAdmin();

      function validNotification() {
        let data = request.resource.data;
        return data.keys().hasAll([
              'targetId', 'targetType', 'reference', 'channel', 'recipient', 'subject', 'body', 'trigger', 'status', 'createdAt'
            ])
          && data.keys().hasOnly([
              'targetId', 'targetType', 'reference', 'channel', 'recipient', 'subject', 'body', 'trigger', 'status', 'createdAt', 'sentAt'
            ])
          && data.targetId is string
          && data.targetId.size() > 0
          && data.targetType in ['booking', 'enquiry']
          && data.channel in ['email', 'sms']
          && data.recipient is string
          && data.recipient.size() > 0
          && data.recipient.size() <= 254
          && data.subject is string
          && data.subject.size() <= 200
          && data.body is string
          && data.body.size() > 0
          && data.body.size() <= 1500
          && data.trigger in ['booking_created', 'payment_received', 'status_changed', 'enquiry_received']
          && data.status == 'queued'
          && data.createdAt == request.time
          && (
            (data.targetType == 'booking'
              && exists(/databases/$(database)/documents/bookings/$(data.targetId)))
            || (data.targetType == 'enquiry'
              && exists(/databases/$(database)/documents/contactEnquiries/$(data.targetId)))
          );
      }
    }

    // Newsletter signups. Anyone can subscribe, only admins can read the list.
    match /newsletter/{subscriberId} {
      allow create: if validSubscriber();
      allow read, update, delete: if isAdmin();

      function validSubscriber() {
        let data = request.resource.data;
        return data.keys().hasOnly(['email', 'source', 'status', 'createdAt', 'updatedAt'])
          && data.email is string
          && data.email.size() >= 5
          && data.email.size() <= 254
          && data.email.matches('^[^ @]+@[^ @]+[.][^ @]+$')
          && data.source is string
          && data.source.size() > 0
          && data.source.size() <= 60
          && data.status == 'subscribed'
          && data.createdAt == request.time
          && data.updatedAt == request.time;
      }
    }

    match /contactEnquiries/{enquiryId} {
      allow create: if validEnquiry();
      allow read, update, delete: if false;

      function validEnquiry() {
        let data = request.resource.data;
        return data.keys().hasAll([
            'name', 'email', 'phone', 'destination', 'packageId', 'packageName',
            'travelDate', 'travelers', 'message', 'createdAt'
          ])
          && data.keys().hasOnly([
            'name', 'email', 'phone', 'destination', 'packageId', 'packageName',
            'travelDate', 'travelers', 'message', 'createdAt'
          ])
          && data.name is string
          && data.name.size() >= 2
          && data.name.size() <= 100
          && data.email is string
          && data.email.size() >= 5
          && data.email.size() <= 254
          && data.email.matches('^[^ @]+@[^ @]+[.][^ @]+$')
          && data.phone is string
          && data.phone.size() >= 7
          && data.phone.size() <= 30
          && data.phone.matches('^[+0-9() -]+$')
          && data.destination in ['shimla', 'manali', 'lahaul-spiti', 'mussoorie', 'dharamshala', 'chamba', 'palampur', 'not-sure']
          && data.packageId is string
          && data.packageId.size() <= 100
          && data.packageName is string
          && data.packageName.size() <= 150
          && (data.travelDate == null || (data.travelDate is string && data.travelDate.size() == 10))
          && data.travelers in ['1', '2', '3', '4']
          && data.message is string
          && data.message.size() <= 1500
          && data.createdAt is timestamp
          && data.createdAt == request.time;
      }
    }
  }
}
